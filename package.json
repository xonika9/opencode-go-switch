{
  "name": "opencode-go-switch",
  "version": "26.11.2201",
  "description": "Go Switch: an OpenCode plugin and Pi extension that keeps you on a working OpenCode Go subscription and switches accounts automatically when a quota runs out.",
  "type": "module",
  "license": "MIT",
  "author": "xonika9",
  "homepage": "https://github.com/xonika9/opencode-go-switch#readme",
  "bugs": {
    "url": "https://github.com/xonika9/opencode-go-switch/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xonika9/opencode-go-switch.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-go",
    "plugin",
    "account-switching",
    "rate-limit",
    "quota",
    "failover",
    "pi-package",
    "pi-extension"
  ],
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js"
    },
    "./pi": {
      "types": "./dist/pi.d.ts",
      "import": "./dist/pi.js"
    }
  },
  "pi": {
    "extensions": [
      "./dist/pi.js"
    ]
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "bun": ">=1.2",
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run check && bun run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@opencode/plugin": ">=2.3.0 <3",
    "effect": "^4.1.0",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@opencode/plugin": "2.3.0",
    "@types/bun": "1.4.4",
    "effect": "4.1.0",
    "solid-js": "1.9.12",
    "typebox": "1.3.27",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
